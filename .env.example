# Claude Code runtime settings. Store real secrets only in the local .env file.
CC_SWITCH_BASE_URL=https://your-claude-compatible-relay.example.com
CC_SWITCH_MODEL=your-model-name
CC_SWITCH_API_KEY=your-key
CC_USR_SUBMITTER=your-real-name
CC_GITHUB_TOKEN=your-github-token
CC_AUTHOR_DIFFICULTY=困难
CC_AUTHOR_DIFFICULTY_WEIGHTS='{"困难":70,"地狱":30}'
CC_AUTHOR_BATCH_SIZE=10

# Docker-based automatic pipeline.
CC_CLAUDE_DOCKER_IMAGE=ccusr-claude-worker:local
CC_CLAUDE_DOCKER_COMMAND=claude
CC_PIPELINE_QC_CONCURRENCY=2
CC_PIPELINE_MODEL_CONCURRENCY=2
CC_PIPELINE_CODEX_CONCURRENCY=2
CC_PIPELINE_READY_TARGET=40
CC_NEWS_READY_TARGET=40
CC_PIPELINE_MODEL_MODE=docker
CC_CLAUDE_WORKER_CPUS=1
CC_CLAUDE_WORKER_MEMORY=2g

# Optional Docker worker supervision thresholds, in seconds.
CC_CLAUDE_HEARTBEAT_SECONDS=5
CC_CLAUDE_START_TIMEOUT=300
CC_CLAUDE_STALLED_TIMEOUT=900
CC_PIPELINE_WORKER_TIMEOUT=3600
CC_PIPELINE_MAX_ATTEMPTS=2
CC_PIPELINE_DELIVERY_MAX_ATTEMPTS=5
# Only enable for an explicitly approved historical delivery backfill.
CC_DELIVERY_ALLOW_LATE=false

# Transient gateway retry and node-wide circuit breaker.
CC_GATEWAY_MAX_ATTEMPTS=3
CC_GATEWAY_BACKOFF_BASE=30
CC_GATEWAY_BACKOFF_MAX=300
CC_GATEWAY_CIRCUIT_THRESHOLD=2
CC_GATEWAY_CIRCUIT_WINDOW=120
CC_GATEWAY_CIRCUIT_COOLDOWN=180

# SOLO2 delivery. Manual confirmation is the safe default.
CC_SOLO2_ORIGIN=https://solo2.jzxhnh.com
CC_SOLO2_AUTO_SUBMIT=false
CC_SOLO2_CONCURRENCY=1
CC_SOLO2_MAX_ATTEMPTS=3

# VPS path used by the legacy compose deployment; normally leave unset locally.
# HOST_PROJECT_ROOT=/opt/UserSatisfactionRating
