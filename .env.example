# Claude Code runtime settings. Store real secrets only in the local .env file.
CC_SWITCH_BASE_URL=https://your-claude-compatible-relay.example.com
CC_SWITCH_MODEL=your-model-name
CC_SWITCH_API_KEY=your-key
CC_USR_SUBMITTER=your-real-name
CC_GITHUB_TOKEN=your-github-token
CC_AUTHOR_DIFFICULTY=中等
CC_AUTHOR_DIFFICULTY_WEIGHTS='{"中等":100}'
CC_AUTHOR_BATCH_SIZE=10

# Docker-based automatic pipeline.
CC_CLAUDE_DOCKER_IMAGE=ccusr-claude-worker:local
CC_CLAUDE_DOCKER_COMMAND=claude
CC_PIPELINE_QC_CONCURRENCY=2
CC_PIPELINE_MODEL_CONCURRENCY=2
CC_PIPELINE_CODEX_CONCURRENCY=2
CC_PIPELINE_MODEL_MODE=docker

# VPS path used by the legacy compose deployment; normally leave unset locally.
# HOST_PROJECT_ROOT=/opt/UserSatisfactionRating
